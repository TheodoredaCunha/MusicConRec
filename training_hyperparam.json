{
    "epochs": 50,
    "batch_size": 32,
    "num_workers": 8,
    "seed": 42,
    "learning_rate": 5e-5,
    "ntxent_temperature": 0.07,
    "lambda_contrastive": 1.0,
    "lambda_recon": 0.2,
    "max_grad_norm": 1.0,
    "lr_scheduler": {
        "type": "ReduceLROnPlateau",
        "factor": 0.5,
        "patience": 2,
        "threshold": 1e-4,
        "min_lr": 1e-7,
        "cooldown": 0,
        "verbose": true
    },
    "traindata_dir": "./data/MusicBench_train.json",
    "valdata_dir": "./data/MusicBench_val.json"
}